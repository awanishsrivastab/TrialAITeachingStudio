        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are an expert curriculum designer. Regenerate ONLY the {{ $json.body.section }} section for this lesson. Do not regenerate anything else.\\n\\nSubject:{{ $json.body.subject }} \\nGrade: {{ $json.body.grade }}\\nTopic: {{ $json.body.topic }}\\nLanguage: {{ $json.body.language }}\\n\\nSection to regenerate: {{ $json.body.section }}\\n\\nIf section is 'lesson_plan', return:\\n{\\\"lesson_plan\\\":{\\\"warm_up\\\":\\\"...\\\",\\\"concepts\\\":[\\\"...\\\"],\\\"activity\\\":\\\"...\\\",\\\"recap\\\":\\\"...\\\",\\\"homework\\\":\\\"...\\\"}}\\n\\nIf section is 'worksheet', return:\\n{\\\"worksheet\\\":{\\\"easy\\\":[{\\\"question\\\":\\\"...\\\",\\\"answer\\\":\\\"...\\\"}],\\\"medium\\\":[{\\\"question\\\":\\\"...\\\",\\\"answer\\\":\\\"...\\\"}],\\\"hard\\\":[{\\\"question\\\":\\\"...\\\",\\\"answer\\\":\\\"...\\\"}]}}\\n\\nIf section is 'quiz', return:\\n{\\\"quiz\\\":{\\\"mcq\\\":[{\\\"question\\\":\\\"...\\\",\\\"options\\\":[\\\"A. ...\\\",\\\"B. ...\\\",\\\"C. ...\\\",\\\"D. ...\\\"],\\\"correct\\\":\\\"A\\\"}],\\\"short_answer\\\":[{\\\"question\\\":\\\"...\\\",\\\"answer\\\":\\\"...\\\",\\\"points\\\":2}]}}\\n\\nIf section is 'rubric' or 'quiz_rubric', return:\\n{\\\"quiz_rubric\\\":\\\"Full 11-mark quiz grading rubric: MCQs 5 x 1 mark, short answers 3 x 2 marks with 0/1/2 mark descriptors\\\"}\\n\\nReturn ONLY valid JSON for that one section. No markdown, no backticks, no explanation.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.8,\n    \"maxOutputTokens\": 2048\n  }\n}",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi"
      },
